{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://crypto-api-rust.athenastudio.my.id/api/",
        "EXPO_PUBLIC_WS_URL": "wss://crypto-api-rust.athenastudio.my.id/api/",
        "EXPO_PUBLIC_CHART_URL": "https://crypto-web.athenastudio.my.id/"
      }
    },
    "dev": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "dev",
        "EXPO_PUBLIC_API_URL": "https://crypto-be-rust.athenastudio.my.id/api/",
        "EXPO_PUBLIC_WS_URL": "wss://crypto-be-rust.athenastudio.my.id/api/",
        "EXPO_PUBLIC_CHART_URL": "https://crypto-web-dev.athenastudio.my.id/"
      }
    }
  }
}
